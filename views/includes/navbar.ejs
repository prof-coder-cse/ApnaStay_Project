<nav class="navbar navbar-expand-md navbar-light bg-white shadow-sm sticky-top py-2">
  <div class="container-fluid d-flex align-items-center justify-content-between">

    <!-- Logo as Compass Icon -->
    <a class="navbar-brand d-flex align-items-center" href="/listings" style="font-size: 1.5rem; color: #ff5a5f; transition: transform 0.2s;">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- Small screen: search + toggle inline -->
    <div class="d-flex d-md-none flex-grow-1 align-items-center justify-content-center position-relative mx-2">
      <form class="flex-grow-1 position-relative">
        <input class="form-control rounded-pill border-1 shadow-sm ps-4" 
               type="search" placeholder="Search listings..." aria-label="Search" 
               style="height: 38px;">
        <button class="btn btn-success rounded-pill px-3 position-absolute end-0 top-0 h-100" type="submit">Search</button>
      </form>
    </div>

    <!-- Navbar toggler for small screens -->
    <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Medium+ screens: normal navbar -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Left links -->
      <ul class="navbar-nav me-auto mb-2 mb-md-0">
        <li class="nav-item">
          <a class="nav-link fw-semibold text-dark" href="/listings">Explore</a>
        </li>
      </ul>

      <!-- Center search for medium+ -->
      <form class="d-none d-md-flex mx-auto my-2 w-100 position-relative" style="max-width: 450px;">
        <input class="form-control rounded-pill border-1 shadow-sm ps-4" 
               type="search" placeholder="Search listings..." aria-label="Search" 
               style="height: 42px;">
        <button class="btn btn-success rounded-pill px-4 position-absolute end-0 top-0 h-100" 
                type="submit">Search</button>
      </form>

      <!-- Right side user links -->
      <ul class="navbar-nav ms-auto mb-2 mb-md-0 d-flex align-items-center">
        <li class="nav-item me-3">
          <a class="nav-link fw-semibold text-dark" href="/listings/new">Airbnb Your Home</a>
        </li>
        <% if (!currentUser) { %>
        <li class="nav-item me-2">
          <a class="btn btn-outline-primary rounded-pill px-3 py-1" href="/signup"><b>Sign Up</b></a>
        </li>
        <li class="nav-item me-2">
          <a class="btn btn-outline-success rounded-pill px-3 py-1" href="/login"><b>Login</b></a>
        </li>
        <% } else { %>
        <li class="nav-item me-3 mt-2">
          <span class="navbar-text fw-semibold text-dark"><%= currentUser.username %></span>
        </li>
        <li class="nav-item">
          <a class="btn btn-outline-danger rounded-pill px-3 py-1" href="/logout"><b>Logout</b></a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* Hover effect for logo */
  .navbar-brand:hover {
    transform: rotate(15deg) scale(1.2);
    color: #ff0000;
  }

  /* Input focus animation */
  .navbar .form-control:focus {
    box-shadow: 0 0 8px rgba(0, 128, 0, 0.3);
    border-color: #28a745;
  }

  /* Search button hover */
  .navbar .btn-success:hover {
    background-color: #28a745;
    transform: scale(1.05);
    transition: all 0.2s;
  }

  /* Nav links hover */
  .navbar-nav .nav-link:hover {
    color: #ff5a5f;
    font-weight: 600;
  }

  /* Smooth transition for everything */
  .navbar, .navbar-nav .nav-link, .navbar-brand, .btn {
    transition: all 0.3s ease;
  }

  /* Optional: make small screen search input a bit smaller */
  @media (max-width: 767px) {
    .navbar .form-control {
      height: 36px;
    }
    .navbar .btn {
      padding: 0 0.75rem;
    }
  }
</style>
