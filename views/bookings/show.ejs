<% layout("layout/boilerplate") %>

<div class="container my-4" style="max-width: 860px;">
  <!-- Action Bar -->
  <div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <a href="/bookings" class="btn btn-outline-secondary rounded-pill btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to My Bookings
    </a>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-dark rounded-pill btn-sm">
        <i class="fa-solid fa-print me-1"></i> Print / Save Voucher
      </button>
      <% if (booking.status === 'confirmed') { %>
        <button type="button" class="btn btn-outline-danger rounded-pill btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal">
          <i class="fa-solid fa-ban me-1"></i> Cancel Reservation
        </button>
      <% } %>
    </div>
  </div>

  <!-- Booking Voucher Card -->
  <div class="card border-0 shadow-lg rounded-4 overflow-hidden print-area">
    <!-- Header Banner -->
    <div class="bg-dark text-white p-4 d-flex flex-wrap justify-content-between align-items-center" style="background: linear-gradient(135deg, #1f2937, #111827);">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <i class="fa-regular fa-compass text-danger fs-3"></i>
          <span class="fs-4 fw-bold">ApnaStay Reservation Voucher</span>
        </div>
        <p class="text-white-50 small mb-0">Official Booking Confirmation & Receipt</p>
      </div>
      <div class="text-md-end mt-3 mt-md-0">
        <span class="text-white-50 small d-block">Booking Reference</span>
        <span class="badge bg-danger fs-5 px-3 py-2 font-monospace tracking-wide"><%= booking.bookingCode %></span>
      </div>
    </div>

    <!-- Status Strip -->
    <div class="py-2 px-4 d-flex justify-content-between align-items-center <%= booking.status === 'confirmed' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %>">
      <span>
        <i class="fa-solid <%= booking.status === 'confirmed' ? 'fa-circle-check' : 'fa-circle-xmark' %> me-1"></i>
        Status: <strong class="text-uppercase"><%= booking.status %></strong>
      </span>
      <small class="text-muted">Booked on <%= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></small>
    </div>

    <div class="card-body p-4">
      <!-- Property & Guest Overview -->
      <div class="row g-4 align-items-center pb-4 border-bottom">
        <div class="col-md-4">
          <img src="<%= booking.listing && booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60' %>" 
               class="img-fluid rounded-3 shadow-sm w-100" 
               alt="Property photo" 
               style="height: 180px; object-fit: cover;">
        </div>
        <div class="col-md-8">
          <h4 class="fw-bold mb-1"><%= booking.listing ? booking.listing.title : 'Listing' %></h4>
          <p class="text-muted mb-2">
            <i class="fa-solid fa-location-dot text-danger me-1"></i>
            <%= booking.listing ? `${booking.listing.location}, ${booking.listing.country}` : '' %>
          </p>
          <div class="row g-2 mt-2">
            <div class="col-sm-6">
              <div class="p-2 bg-light rounded-3">
                <span class="text-muted small d-block">Reserved For:</span>
                <strong class="text-dark"><%= booking.guestName || (booking.user ? booking.user.username : 'Guest') %></strong>
                <span class="text-muted small d-block"><%= booking.guestEmail || (booking.user ? booking.user.email : '') %></span>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="p-2 bg-light rounded-3">
                <span class="text-muted small d-block">Hosted By:</span>
                <strong class="text-dark"><%= booking.listing && booking.listing.owner ? booking.listing.owner.username : 'ApnaStay Host' %></strong>
                <span class="text-muted small d-block">Verified Host</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Schedule Cards -->
      <div class="row g-3 py-4 border-bottom">
        <div class="col-md-4 col-sm-6">
          <div class="border rounded-3 p-3 text-center h-100">
            <span class="text-muted small text-uppercase fw-semibold">Check-In</span>
            <h5 class="fw-bold text-dark mt-1 mb-0"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></h5>
            <small class="text-muted">From 2:00 PM</small>
          </div>
        </div>
        <div class="col-md-4 col-sm-6">
          <div class="border rounded-3 p-3 text-center h-100">
            <span class="text-muted small text-uppercase fw-semibold">Check-Out</span>
            <h5 class="fw-bold text-dark mt-1 mb-0"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></h5>
            <small class="text-muted">By 11:00 AM</small>
          </div>
        </div>
        <div class="col-md-4 col-sm-12">
          <div class="border rounded-3 p-3 text-center h-100 bg-light">
            <span class="text-muted small text-uppercase fw-semibold">Stay Duration</span>
            <h5 class="fw-bold text-dark mt-1 mb-0"><%= booking.nights %> Night<%= booking.nights > 1 ? 's' : '' %></h5>
            <small class="text-muted"><%= booking.guests %> Guest<%= booking.guests > 1 ? 's' : '' %></small>
          </div>
        </div>
      </div>

      <!-- Price Breakdown Invoice -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Payment Receipt</h5>
        <div class="table-responsive">
          <table class="table table-borderless mb-0">
            <tbody>
              <tr>
                <td class="text-muted">&#8377;<%= booking.pricePerNight.toLocaleString('en-IN') %> &times; <%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %></td>
                <td class="text-end fw-semibold">&#8377;<%= booking.nightlyTotal.toLocaleString('en-IN') %></td>
              </tr>
              <tr>
                <td class="text-muted">Wanderlust Platform Service Fee (5%)</td>
                <td class="text-end fw-semibold">&#8377;<%= booking.serviceFee.toLocaleString('en-IN') %></td>
              </tr>
              <tr>
                <td class="text-muted">Applicable Taxes (12% GST)</td>
                <td class="text-end fw-semibold">&#8377;<%= booking.tax.toLocaleString('en-IN') %></td>
              </tr>
              <tr class="border-top">
                <td class="fs-5 fw-bold text-dark pt-3">Total Amount Paid</td>
                <td class="text-end fs-5 fw-bold text-success pt-3">&#8377;<%= booking.totalPrice.toLocaleString('en-IN') %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Verification Seal & Instructions -->
      <div class="row align-items-center pt-4">
        <div class="col-md-8">
          <h6 class="fw-bold mb-1">Check-in Instructions & Policy</h6>
          <ul class="text-muted small ps-3 mb-0">
            <li>Present this digital voucher and a valid government ID upon arrival.</li>
            <li>Free cancellation up to 48 hours prior to the check-in date.</li>
            <li>Need travel or itinerary guidance? Ask WanderAI Concierge on the listing page anytime!</li>
          </ul>
        </div>
        <div class="col-md-4 text-center mt-3 mt-md-0">
          <div class="p-3 border rounded-3 bg-light d-inline-block">
            <i class="fa-solid fa-qrcode fa-4x text-dark mb-1"></i>
            <div class="font-monospace text-muted" style="font-size: 0.75rem;"><%= booking.bookingCode %></div>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.65rem;">VERIFIED PASS</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Cancel Confirmation Modal -->
<% if (booking.status === 'confirmed') { %>
  <div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Cancel Reservation?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to cancel booking <strong>#<%= booking.bookingCode %></strong> for <strong><%= booking.listing ? booking.listing.title : 'this property' %></strong>?</p>
          <div class="alert alert-warning small mb-0">
            <i class="fa-solid fa-info-circle me-1"></i> Your dates will be released and the reservation status will be updated to cancelled.
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Keep Booking</button>
          <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger rounded-pill">Yes, Cancel Booking</button>
          </form>
        </div>
      </div>
    </div>
  </div>
<% } %>

<style>
  @media print {
    .no-print, nav, footer {
      display: none !important;
    }
    .print-area {
      box-shadow: none !important;
      border: 1px solid #ddd !important;
    }
  }
</style>
