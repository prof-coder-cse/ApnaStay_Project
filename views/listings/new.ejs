<% layout("layout/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">
        <br><br>
        <h3>Create New Listing</h3>

        <form action="/listings" method="post" enctype="multipart/form-data" class="needs-validation" novalidate >
            <div class="mb-3">
                <label for="title" class="form-label">Title:</label>
                <input type="text" name="title" id="title" placeholder="Enter title" class="form-control" >
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Title should be valid</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description:</label>
                <textarea name="description" id="description" placeholder="Enter description" class="form-control" ></textarea>
                 <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Description should be valid</div>
            </div>

           
              <div class="mb-3">
                <label for="image" class="form-label">Upload Image</label>
                <input type="file" name="image" id="image" placeholder="Enter image url" class="form-control" required>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price:</label>
                    <input type="text" name="price" id="price" placeholder="5500" class="form-control" >
                     <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Enter a valid number</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country:</label>
                    <input type="text" name="country" id="country" class="form-control" placeholder="India" >
                     <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">country should be valid</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location:</label>
                <input type="text" name="location" id="location" class="form-control" placeholder="Delhi, New Delhi" >
                 <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Location should be valid</div>
            </div>

            <button class="btn btn-danger">Add</button>
        </form>
    </div>
</div>
