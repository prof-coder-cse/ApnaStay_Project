<% layout("/layout/boilerplate") %>

<div class="container mt-4">
  <div class="row">
    <div class="col-8 offset-2 listing-card">
      <h3>Listing Details:</h3>
    </div>
  </div>

   <div class="row mt-3">
    <div class="col-md-8 offset-md-2 listing-card">
      <div class="card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing image">
        <div class="card-body">
          <p class="card-text">
            <strong>Title:</strong> <%= listing.title %><br>
            <i> Owned By:<%= listing.owner.username  %></i>
            <br>
            <strong>Description:</strong> <%= listing.description %><br>
            <strong>Price:</strong> ₹<%= listing.price %><br>
            <strong>Location:</strong> <%= listing.location %><br>
            <strong>Country:</strong> <%= listing.country %>
          </p>
        </div>
      </div>
    </div>
  </div>
  

 <!-- Buttons Row -->
 
<% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
  <div class="row mt-3">
    <div class="col-md-2 offset-md-2">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark w-100">Edit</a>
    </div>
    <div class="col-md-2">
      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button type="submit" class="btn btn-danger w-100">Delete</button>
      </form>
    </div>
  </div>
<% } %> 
  

<div class="offset-2 mt-2">
  <hr>
  <% if(currentUser) {%>
  <h4>Leave a Review</h4>
</div>
<div class="offset-2 mt-2">
